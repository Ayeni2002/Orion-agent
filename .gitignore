# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# environment — never commit real values.
# Ignore every .env* variant rather than a list of known ones: Next.js reads
# .env.development, .env.production and .env.test too, and an enumerated list
# silently misses whichever one is added next. .env.example is the documented
# template and stays committed.
.env
.env.*
!.env.example

# testing
coverage/

# typescript
*.tsbuildinfo

# deployment
.vercel

# editors and os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
