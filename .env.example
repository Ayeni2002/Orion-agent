# Copy this file to .env and fill in the four values below.

# The full chat endpoint URL. Anthropic-compatible providers document this as a
# base URL and let the SDK append /v1/messages; this client posts to exactly
# what you write here, so include the suffix.
LLM_ENDPOINT=https://api.deepseek.com/anthropic/v1/messages

# Which wire format that endpoint speaks: "anthropic" or "openai".
#   anthropic -> x-api-key header, top-level "system", reply at content[0].text
#   openai    -> Authorization: Bearer, system as the first message, JSON mode
LLM_API_STYLE=anthropic

# The exact model id from your provider's dashboard. There is no default on
# purpose: a wrong id fails at the API instead of at startup.
LLM_MODEL=deepseek-v4-flash

# Your key for that provider.
LLM_API_KEY=sk-your-key-here
