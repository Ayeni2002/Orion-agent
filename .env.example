# Orion environment variables — template only.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials, and never put a real secret in this file.

# Only variables prefixed NEXT_PUBLIC_ reach the browser. No secret should ever
# carry that prefix.

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key. It is exposed to the browser by design — Row Level
# Security protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
# Bypasses Row Level Security entirely. Server-side only: never prefix it with
# NEXT_PUBLIC_ and never read it from a module the client bundle can reach.
# Not read by any code yet — listed so it is not invented ad hoc later.
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# Read by `src/lib/env.ts` and nowhere else. Orion's model provider is
# configuration rather than code: no provider is hard-coded and no provider SDK
# is a dependency. The names are deliberately vendor-neutral.
#
# Phase 3 implements the provider *interface* plus one deterministic local
# adapter. No external provider exists yet, so "dev" is the only supported
# value — naming anything else makes every run fail loudly rather than quietly
# running the development adapter while appearing to be a real model.
#
# Leaving all four unset is the supported default: Orion plans, executes and
# evaluates an objective with no credentials and no network access at all.
ORION_LLM_PROVIDER=
# The model id reported on every execution. Defaults to the adapter's own
# deterministic model id.
ORION_LLM_MODEL=
# Reserved for a real adapter. Unread by the development adapter, which never
# contacts anything.
ORION_LLM_BASE_URL=
# A credential would live here. It is read *only* to compute a boolean saying
# whether one is present — the value is never returned from `env.ts`, so it
# cannot reach a response body, an error message or a log line.
ORION_LLM_API_KEY=
