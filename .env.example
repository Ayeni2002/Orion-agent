# Orion environment variables — template only.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials, and never put a real secret in this file.

# Only variables prefixed NEXT_PUBLIC_ reach the browser. No secret should ever
# carry that prefix.

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key. It is exposed to the browser by design — Row Level
# Security protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
# Bypasses Row Level Security entirely. Server-side only: never prefix it with
# NEXT_PUBLIC_ and never read it from a module the client bundle can reach.
# Not read by any code yet — listed so it is not invented ad hoc later.
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# Read by `src/lib/env.ts` and nowhere else. Orion's model provider is
# configuration rather than code: no provider is hard-coded and no provider SDK
# is a dependency.
#
# LLM_API_STYLE names the *wire protocol*, not the vendor. "openai" is the
# OpenAI-compatible `/chat/completions` protocol, which OpenRouter, Groq,
# Together, Fireworks, vLLM, LM Studio and OpenAI itself all speak — so any of
# them is configured by pointing LLM_ENDPOINT at it rather than by adding code.
# "gemini" is Google's native `generateContent`, which exists as its own style
# because it is the only route to Google Search grounding.
#
# Leaving every value unset is the supported default: Orion plans, executes and
# evaluates an objective with the deterministic local adapter, with no
# credentials and no network access at all.
#
# Supported values: "dev" (default) | "openai" | "gemini"
LLM_API_STYLE=

# Base URL only — the style's own path is appended, and which path that is
# depends on the style: `/chat/completions` for "openai",
# `/models/<model>:generateContent` for "gemini".
# For OpenRouter: https://openrouter.ai/api/v1
#
# Optional for "gemini", and only for "gemini": that style is one vendor at one
# canonical host, so it defaults to Google's own base URL. Set it anyway to route
# through a proxy or a regional host. Every other remote style must name one,
# because "openai" describes many vendors and a default would be a guess about
# which one was meant.
LLM_ENDPOINT=

# Model id, in the endpoint's own namespace. Required for every style except
# "dev", because a gateway addresses models in its own catalogue and any
# fallback chosen here would be a guess about someone else's.
# OpenRouter spells these "<vendor>/<model>", e.g. openai/gpt-4o or
# anthropic/claude-sonnet-4.
# Gemini spells them plainly, e.g. gemini-2.5-flash — and a leading "models/" is
# accepted too, so the form Google's REST documentation uses also works.
LLM_MODEL=

# A credential. Read only by the adapter that is about to send it, and written
# straight into a header — `Authorization` for "openai", `x-goog-api-key` for
# "gemini", never a query parameter, because a URL is copied into every log that
# sees the request line. `env.ts` exposes only a boolean saying whether one is
# present, so the value cannot reach a response body, an error message or a log
# line.
# Optional: a local endpoint such as vLLM or LM Studio needs no key. Gemini does
# require one.
LLM_API_KEY=

# --- Research (Phase 5) ---
# There is no research endpoint and no research credential here, deliberately.
# Retrieval borrows the model configuration: OpenRouter's search is a chat
# completion with a search plugin attached, and Gemini's grounding is a `tools`
# entry on the same `generateContent` call. Both therefore use the same
# LLM_ENDPOINT and the same LLM_API_KEY as planning, and a second copy of the key
# would be a second place to rotate one credential, one of which would eventually
# be missed.
#
# Whether retrieval is available is therefore derived rather than declared, and
# there are two ways it can be true — derived differently, because the underlying
# facts differ:
#
#   - "openai": derived narrowly from the host. A research run can search exactly
#     when LLM_ENDPOINT points at openrouter.ai, whose `web` plugin is the one
#     this build knows how to ask. Every other OpenAI-compatible endpoint — Groq,
#     Together, vLLM, LM Studio, a local server — speaks /chat/completions but has
#     no such plugin, and a request carrying one would be ignored while the run
#     reported itself as searching.
#   - "gemini": derived from the style, with no host to inspect. Grounding is not
#     a plugin a host may or may not implement; it is part of the one endpoint and
#     the one credential, so choosing the style settles the question.
#
# An endpoint that cannot search resolves to the development adapter, whose
# isConfigured is false, so every run stops at `search_not_configured` before
# planning — visibly, with an explanation, rather than appearing to search and
# finding nothing.
#
# So there are three working configurations, and they differ in what they unlock.
#
# 1. Agent runs only — free, and no sourced answers. Any OpenAI-compatible
#    endpoint works; Groq has a free tier and needs no card. Confirm the model id
#    in the provider's own console rather than copying an example from here,
#    because these are retired on a schedule and a stale one fails at the first
#    call, not at startup. Research stays unavailable, by design.
#      LLM_API_STYLE=openai
#      LLM_ENDPOINT=https://api.groq.com/openai/v1
#      LLM_MODEL=<a current id from console.groq.com/docs/models>
#      LLM_API_KEY=<your Groq key>
#
# 2. Agent runs AND retrieval, via OpenRouter — billed. Web search is charged on
#    top of tokens and a `:free` model slug does not exempt it.
#      LLM_API_STYLE=openai
#      LLM_ENDPOINT=https://openrouter.ai/api/v1
#      LLM_MODEL=openai/gpt-4o
#      LLM_API_KEY=<your OpenRouter key>
#
# 3. Agent runs AND retrieval, via Google — billed against a Google AI Studio
#    key. One key and one endpoint for both, and LLM_ENDPOINT is not needed
#    because the style supplies it. As with Groq, confirm the model id in the
#    provider's own console: Google retires and renames these on a schedule.
#      LLM_API_STYLE=gemini
#      LLM_MODEL=<a current id, e.g. gemini-2.5-flash>
#      LLM_API_KEY=<your Google AI Studio key>
#
#    One thing to expect before you try it, because it is a property of grounding
#    rather than a bug: Google returns the *pages* a search found, not their text.
#    So sources retrieved this way carry a URL and a title and no passage, and a
#    run's findings will say it could not quote them. An OpenAI/OpenRouter
#    retrieval carries passages and produces quoted findings. Neither is invented
#    where it has nothing to quote — which is the point — but the two do not
#    produce the same kind of result, and this one is the thinner of the two.

# Optional. The model used to fetch sources, when it should differ from
# LLM_MODEL. Defaults to LLM_MODEL. A search call is short and a plan is not, so
# fetching with a cheaper model and planning with a stronger one is reasonable.
# It means the same thing for both retrieval paths, e.g. openai/gpt-4o-mini for
# OpenRouter or gemini-2.5-flash-lite for Gemini.
RESEARCH_SEARCH_MODEL=

# --- Research limits ---
# §10's ceilings, made explicit and configurable. Every one of these exists
# because the alternative is an unbounded loop reaching a metered endpoint.
#
# Each must be a positive whole number or be left unset. A malformed value
# throws rather than falling back to the default: an operator who typed
# `RESEARCH_MAX_SOURCES=abc` and silently got 20 would believe they had set a
# ceiling they had not, and the failure would appear as an unexpectedly
# expensive run rather than as a configuration error.
#
# A run that reaches one of these records which one it was and returns what it
# found. The result is reported `insufficient` rather than `sufficient`, because
# a run stopped at a ceiling has not finished looking.

# Retrieval tasks planned from one question. A plan longer than this is
# truncated, and the truncation is recorded.
# Default: 5
RESEARCH_MAX_TASKS=

# Results kept per task. The search tool also has a structural ceiling of 10,
# and the smaller of the two applies.
# Default: 5
RESEARCH_MAX_SOURCES_PER_TASK=

# Sources retained across the whole run, after deduplication. Tasks that would
# exceed it are skipped and the skip is recorded.
# Default: 20
RESEARCH_MAX_SOURCES=

# Findings extracted across the whole run. Extraction stops at this number.
# Default: 50
RESEARCH_MAX_FINDINGS=

# Wall-clock ceiling for the execution loop, in milliseconds. Checked between
# tasks, so this bounds a run rather than interrupting one mid-request.
# Default: 120000
RESEARCH_MAX_DURATION_MS=
