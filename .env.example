# Orion environment variables — template only.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials, and never put a real secret in this file.

# Only variables prefixed NEXT_PUBLIC_ reach the browser. No secret should ever
# carry that prefix.

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key. It is exposed to the browser by design — Row Level
# Security protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
# Bypasses Row Level Security entirely. Server-side only: never prefix it with
# NEXT_PUBLIC_ and never read it from a module the client bundle can reach.
# Not read by any code yet — listed so it is not invented ad hoc later.
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# Read by `src/lib/env.ts` and nowhere else. Orion's model provider is
# configuration rather than code: no provider is hard-coded and no provider SDK
# is a dependency.
#
# LLM_API_STYLE names the *wire protocol*, not the vendor. "openai" is the
# OpenAI-compatible `/chat/completions` protocol, which OpenRouter, Groq,
# Together, Fireworks, vLLM, LM Studio and OpenAI itself all speak — so any of
# them is configured by pointing LLM_ENDPOINT at it rather than by adding code.
#
# Leaving every value unset is the supported default: Orion plans, executes and
# evaluates an objective with the deterministic local adapter, with no
# credentials and no network access at all.
#
# Supported values: "dev" (default) | "openai"
LLM_API_STYLE=

# Base URL only — no `/chat/completions` suffix, which the adapter appends.
# For OpenRouter: https://openrouter.ai/api/v1
LLM_ENDPOINT=

# Model id, in the endpoint's own namespace. Required for every style except
# "dev", because a gateway addresses models in its own catalogue and any
# fallback chosen here would be a guess about someone else's.
# OpenRouter spells these "<vendor>/<model>", e.g. openai/gpt-4o or
# anthropic/claude-sonnet-4.
LLM_MODEL=

# A credential. Read only by the adapter that is about to send it, and written
# straight into an `Authorization` header — `env.ts` exposes only a boolean
# saying whether one is present, so the value cannot reach a response body, an
# error message or a log line.
# Optional: a local endpoint such as vLLM or LM Studio needs no key.
LLM_API_KEY=
